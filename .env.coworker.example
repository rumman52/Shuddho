# Backend only. Copy to .env.coworker and configure real services before use.
# Keep false until migrations, identity, private storage and worker are ready.
SHUDDHO_COWORKER_ENABLED=false
# First production cohort: backend enforcement is independent of frontend visibility.
# Populate with comma-separated 64-char account IDs only after the cohort admission staging exercise.
SHUDDHO_COWORKER_COHORT_ENFORCED=false
SHUDDHO_COWORKER_COHORT_ACCOUNT_IDS=
SHUDDHO_COWORKER_COHORT_MAX_USERS=25
# Enable after every API and worker/dispatcher instance has Part 3 code.
SHUDDHO_WORK_SERVICES_ENABLED=false
SHUDDHO_ARTIFACT_SERVICES_ENABLED=false
# Optional Wave C adapter. Configure backend secrets and staging before enabling.
SHUDDHO_RESEARCH_SERVICES_ENABLED=false
SHUDDHO_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Agent Runtime foundation. Keep disabled until #110 migrations, API and planner rollout are complete.
SHUDDHO_AGENT_RUNTIME_ENABLED=false
SHUDDHO_COWORKER_ACTIVE_AGENT_RUNS=2
SHUDDHO_AGENT_RUN_TIMEOUT_SECONDS=1800
# Structured Agent Memory. Keep disabled until migration 0006 and privacy staging are complete.
SHUDDHO_AGENT_MEMORY_ENABLED=false
SHUDDHO_AGENT_MEMORY_FACTS=200
SHUDDHO_AGENT_MEMORY_CONTEXT_FACTS=20
SHUDDHO_AGENT_MEMORY_CONTEXT_BYTES=8192
# Bounded intelligent planner. Deterministic #111 planning remains the fallback while disabled.
SHUDDHO_AGENT_INTELLIGENT_PLANNER_ENABLED=false
SHUDDHO_AGENT_HANDOFFS_ENABLED=false
SHUDDHO_AGENT_MULTI_HANDOFFS_ENABLED=false
SHUDDHO_AGENT_DEPENDENCY_GRAPH_ENABLED=false
SHUDDHO_AGENT_PARALLEL_EXECUTION_ENABLED=false
SHUDDHO_AGENT_OUTCOME_REPLAN_ENABLED=false
SHUDDHO_AGENT_HANDOFF_BYTES=12000
SHUDDHO_AGENT_HANDOFF_SOURCES=2
SHUDDHO_AGENT_MAX_PARALLEL_STEPS=2
SHUDDHO_AGENT_PLANNER_CALLS=2
SHUDDHO_AGENT_PLANNER_TOKEN_BUDGET=16000
SHUDDHO_AGENT_PLANNER_MAX_OUTPUT_TOKENS=1200
# Wave D: backend-only OAuth credentials. Keep disabled through staging setup.
SHUDDHO_ACTIONS_ENABLED=false
SHUDDHO_ACTION_ATTACHMENTS_ENABLED=false
SHUDDHO_ACTION_REMINDERS_ENABLED=false
SHUDDHO_GOOGLE_CLIENT_ID=
SHUDDHO_GOOGLE_CLIENT_SECRET=
# Exact FRONTEND callback registered on the Google Web application OAuth client.
SHUDDHO_GOOGLE_REDIRECT_URI=https://YOUR-FRONTEND-DOMAIN/oauth/google/callback
# Optional second provider. Keep false until Microsoft Entra/Graph staging is complete.
SHUDDHO_MICROSOFT_ACTIONS_ENABLED=false
SHUDDHO_MICROSOFT_CLIENT_ID=
SHUDDHO_MICROSOFT_CLIENT_SECRET=
SHUDDHO_MICROSOFT_TENANT=organizations
SHUDDHO_MICROSOFT_REDIRECT_URI=https://YOUR-FRONTEND-DOMAIN/oauth/microsoft/callback
# Base64-encoded 32 random bytes; same secret on the API and every worker.
SHUDDHO_CONNECTOR_ENCRYPTION_KEY=
SHUDDHO_COWORKER_DAILY_ACTIONS=20
SHUDDHO_COWORKER_ENV=production
SHUDDHO_COWORKER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SHUDDHO_AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
SHUDDHO_AUTH_AUDIENCE=authenticated
SHUDDHO_COWORKER_STORAGE=s3
SHUDDHO_COWORKER_BUCKET=shuddho-private-files
SHUDDHO_COWORKER_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
# Prefer workload identity/IAM roles; static credentials, if needed, stay here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SHUDDHO_TEMPORAL_ADDRESS=NAMESPACE.REGION.tmprl.cloud:7233
SHUDDHO_TEMPORAL_NAMESPACE=NAMESPACE
SHUDDHO_TEMPORAL_API_KEY=
SHUDDHO_TEMPORAL_TLS=true
SHUDDHO_TEMPORAL_TASK_QUEUE=shuddho-documents-v1
SHUDDHO_COWORKER_DAILY_TASKS=20
SHUDDHO_COWORKER_ACTIVE_TASKS=2
SHUDDHO_COWORKER_DAILY_TOKENS=500000
SHUDDHO_COWORKER_TASK_TOKENS=100000
SHUDDHO_COWORKER_STORAGE_BYTES=268435456
SHUDDHO_LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
SHUDDHO_CORRECTOR_ENABLED=false
SHUDDHO_DETECTOR_ENABLED=false
SHUDDHO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHUDDHO_LOG_RAW_TEXT=false

# Shared provider-capacity governor. Review against measured provider quota before production.
SHUDDHO_PROVIDER_MAX_CONCURRENT_CALLS=8
SHUDDHO_PROVIDER_MAX_CONCURRENT_PER_WORKSPACE=2
SHUDDHO_PROVIDER_MAX_RESERVED_TOKENS=800000
SHUDDHO_PROVIDER_MAX_RESERVED_TOKENS_PER_WORKSPACE=200000
SHUDDHO_PROVIDER_DAILY_TOKEN_BUDGET=5000000
SHUDDHO_PROVIDER_LEASE_SECONDS=120
