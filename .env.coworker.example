# Backend only. Copy to .env.coworker and configure real services before use.
# Keep false until migrations, identity, private storage and worker are ready.
SHUDDHO_COWORKER_ENABLED=false
SHUDDHO_COWORKER_ENV=production
SHUDDHO_COWORKER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SHUDDHO_AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
SHUDDHO_AUTH_AUDIENCE=authenticated
SHUDDHO_COWORKER_STORAGE=s3
SHUDDHO_COWORKER_BUCKET=shuddho-private-files
SHUDDHO_COWORKER_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
# Prefer workload identity/IAM roles; static credentials, if needed, stay here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SHUDDHO_TEMPORAL_ADDRESS=NAMESPACE.REGION.tmprl.cloud:7233
SHUDDHO_TEMPORAL_NAMESPACE=NAMESPACE
SHUDDHO_TEMPORAL_API_KEY=
SHUDDHO_TEMPORAL_TLS=true
SHUDDHO_TEMPORAL_TASK_QUEUE=shuddho-documents-v1
SHUDDHO_COWORKER_DAILY_TASKS=20
SHUDDHO_COWORKER_ACTIVE_TASKS=2
SHUDDHO_COWORKER_DAILY_TOKENS=500000
SHUDDHO_COWORKER_TASK_TOKENS=100000
SHUDDHO_COWORKER_STORAGE_BYTES=268435456
SHUDDHO_LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
SHUDDHO_CORRECTOR_ENABLED=false
SHUDDHO_DETECTOR_ENABLED=false
SHUDDHO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHUDDHO_LOG_RAW_TEXT=false
