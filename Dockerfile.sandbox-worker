FROM node:22-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.11 python3.11-minimal bubblewrap ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system shuddho-sandbox \
    && useradd --system --gid shuddho-sandbox --home-dir /nonexistent --shell /usr/sbin/nologin shuddho-sandbox

WORKDIR /worker
COPY scripts/sandbox_worker.py /worker/sandbox_worker.py
RUN chown -R shuddho-sandbox:shuddho-sandbox /worker

USER shuddho-sandbox
CMD ["python3.11", "/worker/sandbox_worker.py"]
