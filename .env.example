# Shuddho environment example
# Copy only the section for the service you are configuring. Never commit a real key.

# ============================================================================
# 1. RENDER PRODUCTION — Python backend only (server-side; secrets stay here)
# ============================================================================
# Render supplies PORT. Do not set PORT in the Render dashboard.
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
SHUDDHO_LLM_PROVIDER=gemma
SHUDDHO_ENABLE_LLM=true
SHUDDHO_DETECTOR_ENABLED=false
SHUDDHO_CORRECTOR_ENABLED=false
SHUDDHO_ALLOWED_ORIGINS=https://shuddho-web-editor.vercel.app
SHUDDHO_LOG_RAW_TEXT=false

# Optional backend tuning (still server-side; not Vercel variables)
SHUDDHO_LLM_ON_CHECK=manual
SHUDDHO_LLM_TOTAL_TIMEOUT_SECONDS=50
SHUDDHO_LLM_INTERACTIVE_TIMEOUT_SECONDS=45
SHUDDHO_LLM_BACKGROUND_TIMEOUT_SECONDS=50
SHUDDHO_GEMMA_TIMEOUT_SECONDS=30
SHUDDHO_MAX_AI_TEXT_CHARS=5000
SHUDDHO_LLM_MAX_CANDIDATES=8
SHUDDHO_LLM_MAX_CANDIDATE_CHARS=2200
SHUDDHO_LLM_MAX_COMPLETION_TOKENS=1400
SHUDDHO_LLM_CACHE_TTL_SECONDS=86400
SHUDDHO_LLM_CIRCUIT_FAILURE_LIMIT=5
SHUDDHO_LLM_CIRCUIT_WINDOW_SECONDS=300
SHUDDHO_LLM_CIRCUIT_COOLDOWN_SECONDS=180

# ============================================================================
# 2. VERCEL PRODUCTION — public browser-build variables only; never add secrets
# ============================================================================
# Prefer omitting VITE_API_BASE_URL so the app uses the /backend rewrite.
# If the dashboard requires an explicit value, use only: VITE_API_BASE_URL=/backend
VITE_COMPETITION_DEMO_MODE=false
VITE_USE_GATEWAY=true
VITE_ENABLE_LOCAL_FALLBACK=false
# Never put GOOGLE_API_KEY, GEMMA_MODEL, or other backend variables in Vercel.

# ============================================================================
# 3. LOCAL NODE GATEWAY — development only; do not copy to Render production
# ============================================================================
PORT=4000
NODE_ENV=development
SHUDDHO_NLP_PROVIDER=python
SHUDDHO_PYTHON_API_URL=http://127.0.0.1:8000
SHUDDHO_PROVIDER_TIMEOUT_MS=50000
SHUDDHO_ENABLE_LOCAL_FALLBACK=true
SHUDDHO_MAX_TEXT_CHARS=10000
DATABASE_URL=postgresql://shuddho:shuddho@localhost:5432/shuddho
REDIS_URL=redis://localhost:6379

# Local Python browser origins:
# SHUDDHO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# The API reads only the repo-root .env file in local development.
# Do not leave a deployed frontend pointing at localhost.

# ============================================================================
# 4. LOCAL OPTIONAL ML — requires the ml extra/checkpoints; never use on Render
# ============================================================================
SHUDDHO_DETECTOR_ENABLED=auto
SHUDDHO_DETECTOR_CHECKPOINT=artifacts/detector/detector-base
SHUDDHO_CORRECTOR_ENABLED=auto
SHUDDHO_CORRECTOR_CHECKPOINT=artifacts/corrector/corrector-base
