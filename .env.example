# Frontend, used by Vite at build time. In Vercel this must be a public HTTPS
# tunnel URL while the backend runs on your computer.
VITE_API_BASE_URL=https://your-public-backend-tunnel-url
VITE_USE_GATEWAY=true
VITE_ENABLE_LOCAL_FALLBACK=false

# TypeScript gateway
PORT=4000
NODE_ENV=development
SHUDDHO_NLP_PROVIDER=python
SHUDDHO_PYTHON_API_URL=http://127.0.0.1:8000
SHUDDHO_ENABLE_LOCAL_FALLBACK=true
SHUDDHO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://shuddho-web-editor.vercel.app
SHUDDHO_ALLOW_VERCEL_PREVIEWS=false
SHUDDHO_LOG_RAW_TEXT=false
SHUDDHO_MAX_TEXT_CHARS=10000

# Python backend
SHUDDHO_PYTHON_HOST=0.0.0.0
SHUDDHO_PYTHON_PORT=8000
SHUDDHO_DETECTOR_ENABLED=auto
SHUDDHO_DETECTOR_CHECKPOINT=artifacts/detector/detector-base
SHUDDHO_CORRECTOR_ENABLED=auto
SHUDDHO_CORRECTOR_CHECKPOINT=artifacts/corrector/corrector-base

# Legacy Next.js frontend, if used separately
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4000/ws/docs
NEXT_PUBLIC_ENABLE_WS_SYNC=false

# Data
DATABASE_URL=postgresql://shuddho:shuddho@localhost:5432/shuddho
REDIS_URL=redis://localhost:6379
