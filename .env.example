# TypeScript gateway
PORT=4000
NODE_ENV=development
SHUDDHO_NLP_PROVIDER=python
SHUDDHO_PYTHON_API_URL=http://127.0.0.1:8000
SHUDDHO_ENABLE_LOCAL_FALLBACK=true
SHUDDHO_MAX_TEXT_CHARS=10000
SHUDDHO_LOG_RAW_TEXT=false
SHUDDHO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000,https://shuddho-web-editor.vercel.app
SHUDDHO_ALLOW_VERCEL_PREVIEWS=false

# Python backend
# The API reads only the repo-root .env file. Do not leave a deployed frontend pointing at localhost.
SHUDDHO_PYTHON_HOST=0.0.0.0
SHUDDHO_PYTHON_PORT=8000
SHUDDHO_DETECTOR_ENABLED=auto
SHUDDHO_DETECTOR_CHECKPOINT=artifacts/detector/detector-base
SHUDDHO_CORRECTOR_ENABLED=auto
SHUDDHO_CORRECTOR_CHECKPOINT=artifacts/corrector/corrector-base

# Vite web editor
# Local development default:
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_USE_GATEWAY=true

# Vercel production/preview/development environments:
# Set these in Vercel Environment Variables instead of using localhost.
# VITE_API_BASE_URL must be configured for Production, Preview, and Development.
# VITE_API_BASE_URL=https://shuddho-api.onrender.com
# VITE_USE_GATEWAY=true

# Legacy Next.js frontend, if used separately
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:4000/ws/docs
NEXT_PUBLIC_ENABLE_WS_SYNC=false

# Data
DATABASE_URL=postgresql://shuddho:shuddho@localhost:5432/shuddho
REDIS_URL=redis://localhost:6379

# Render production:
# SHUDDHO_CORRECTOR_ENABLED=true
# SHUDDHO_CORRECTOR_CHECKPOINT=artifacts/corrector/corrector-base
# SHUDDHO_DETECTOR_ENABLED=true
# SHUDDHO_DETECTOR_CHECKPOINT=artifacts/detector/detector-base
# SHUDDHO_ALLOWED_ORIGINS=https://shuddho-web-editor.vercel.app
# SHUDDHO_LOG_RAW_TEXT=false
# For Vercel previews, append the exact preview origin to SHUDDHO_ALLOWED_ORIGINS or implement safe trusted-preview CORS handling.
