{
  "name": "detector-base",
  "seed": 42,
  "max_length": 256,
  "batch_size": 16,
  "epochs": 10,
  "learning_rate": 0.0003,
  "device": "auto",
  "model": {
    "vocab_size": 4000,
    "hidden_size": 128,
    "num_heads": 4,
    "num_layers": 2,
    "num_labels": 5
  },
  "data": {
    "train_path": "data/datasets/train/detector.synthetic.jsonl",
    "validation_path": "data/datasets/valid/detector.synthetic.jsonl"
  },
  "output": {
    "dir": "artifacts/detector/detector-base"
  },
  "inference": {
    "confidence_threshold": 0.8
  }
}
