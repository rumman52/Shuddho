{
  "name": "shuddho",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/web-editor",
    "apps/chrome-extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @shuddho/api & npm run dev --workspace @shuddho/web",
    "dev:web": "npm run dev --workspace @shuddho/web",
    "dev:api": "npm run dev --workspace @shuddho/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web-editor": "npm run build --workspace apps/web-editor",
    "build:extension": "npm run build --workspace apps/chrome-extension",
    "dev:web-editor": "npm run dev --workspace @shuddho/web-editor",
    "dev:python-api": "python -m uvicorn services.api.shuddho_api.app:app --host 127.0.0.1 --port 8000 --reload",
    "dev:all": "npm run dev:api & npm run dev:web-editor"
  }
}
