# Public browser configuration only. Never put service-role or provider secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave unset for local development (defaults to http://127.0.0.1:8000).
# Production defaults to the same-origin /backend Vercel rewrite.
# VITE_COWORKER_API_BASE_URL=/backend
# Optional navigation target. Leave unset for the local Coworker server on port 5174.
# Set to /coworker only when both routes are served by the same-origin web-editor shell.
# VITE_COWORKER_APP_URL=/coworker
