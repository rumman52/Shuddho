# Production defaults to the same-origin /backend proxy. Leave this unset, or
# use VITE_API_BASE_URL=/backend only when an explicit dashboard value is needed.
VITE_USE_GATEWAY=true
VITE_ENABLE_LOCAL_FALLBACK=false

VITE_COMPETITION_DEMO_MODE=false
# Coworker feature gate; these are public browser values, never service secrets.
VITE_COWORKER_ENABLED=false
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Use /backend behind Vercel, or a trusted HTTPS API origin.
VITE_COWORKER_API_BASE_URL=/backend
