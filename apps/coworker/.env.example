# Public browser configuration only. Never put service-role or provider secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same-origin gateway route; local development may use http://127.0.0.1:8000.
VITE_COWORKER_API_BASE_URL=/backend
# Optional navigation target. Leave unset for the local Editor server on port 5175.
# Set to /editor only when both routes are served by the same-origin web-editor shell.
# VITE_EDITOR_APP_URL=/editor
