generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String?  @unique
  displayName String?
  createdAt   DateTime @default(now())
  documents   Document[]
  preferences UserPreference?
  feedback    SuggestionFeedback[]
  events      Event[]
}

model UserPreference {
  id                        String   @id @default(uuid())
  userId                    String?  @unique
  language                  String   @default("bn")
  dialect                   String   @default("standard")
  enabledSuggestionTypes    String[]
  productImprovementConsent Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
  user                      User?    @relation(fields: [userId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  ownerId   String?
  title     String   @default("Untitled draft")
  text      String   @default("")
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User?    @relation(fields: [ownerId], references: [id])
  revisions DocumentRevision[]
  feedback  SuggestionFeedback[]
  events    Event[]
}

model DocumentRevision {
  id         String   @id @default(uuid())
  documentId String
  revision   Int
  text       String
  operation  Json?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, revision])
}

model SuggestionFeedback {
  id             String   @id @default(uuid())
  userId         String?
  documentId     String?
  suggestionId   String?
  suppressionKey String?
  ruleId         String?
  type           String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User?     @relation(fields: [userId], references: [id])
  document       Document? @relation(fields: [documentId], references: [id])
}

model Event {
  id             String   @id @default(uuid())
  type           String
  timestamp      DateTime @default(now())
  requestId      String?
  documentId     String?
  userId         String?
  suggestionId   String?
  suppressionKey String?
  language       String   @default("bn")
  metadata       Json?
  user           User?     @relation(fields: [userId], references: [id])
  document       Document? @relation(fields: [documentId], references: [id])
}
