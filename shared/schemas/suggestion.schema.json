{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShuddhoSuggestion",
  "type": "object",
  "required": [
    "id",
    "rule_id",
    "category",
    "subtype",
    "span_start",
    "span_end",
    "original_text",
    "replacement_options",
    "confidence",
    "explanation_bn",
    "explanation_en",
    "source",
    "severity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s_[0-9]+_[0-9]+$"
    },
    "rule_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["spelling", "grammar", "punctuation", "spacing", "register", "clarity", "rewrite_only"]
    },
    "subtype": {
      "type": "string"
    },
    "span_start": {
      "type": "integer",
      "minimum": 0
    },
    "span_end": {
      "type": "integer",
      "minimum": 0
    },
    "original_text": {
      "type": "string"
    },
    "replacement_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "explanation_bn": {
      "type": "string"
    },
    "explanation_en": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["rule", "spell", "model", "hybrid"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "feedback_key": {
      "type": ["string", "null"]
    },
    "conflict_group_id": {
      "type": ["string", "null"]
    },
    "is_primary": {
      "type": "boolean"
    },
    "primary_reason": {
      "type": ["string", "null"]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "category",
          "subtype",
          "original_text",
          "replacement_options",
          "confidence",
          "explanation_bn",
          "explanation_en",
          "source",
          "severity"
        ],
        "properties": {
          "id": { "type": "string" },
          "rule_id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["spelling", "grammar", "punctuation", "spacing", "register", "clarity", "rewrite_only"]
          },
          "subtype": { "type": "string" },
          "original_text": { "type": "string" },
          "replacement_options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "explanation_bn": { "type": "string" },
          "explanation_en": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["rule", "spell", "model", "hybrid"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "feedback_key": {
            "type": ["string", "null"]
          },
          "suppression_key": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
