{
  "version": 2,
  "buildCommand": "npm run build:web-editor",
  "outputDirectory": "apps/web-editor/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://shuddho-api.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
